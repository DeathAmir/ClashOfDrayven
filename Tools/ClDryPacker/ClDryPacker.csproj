    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>cldrypk</AssemblyName>
    <RootNamespace>ClDryPacker</RootNamespace>
    <PlatformTarget>AnyCPU</PlatformTarget>
